<import Layout from "components/Layout">

<Layout title="Documentation" subtitle="">
<style>
    .docs-hero {
        padding: 40px 0 32px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        margin-bottom: 48px;
    }
    .docs-hero h1 {
        font-size: 2.4rem;
        font-weight: 800;
        margin: 0 0 12px 0;
        background: linear-gradient(135deg, #e8f0ec 30%, #4cc496 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .docs-hero p {
        color: rgba(232,240,236,0.5);
        font-size: 1.05rem;
        line-height: 1.7;
        margin: 0;
        max-width: 600px;
    }

    .docs-grid {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 48px;
        align-items: start;
    }

    /* Sidebar */
    .docs-nav {
        position: sticky;
        top: 80px;
    }
    .docs-nav-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 700;
        color: rgba(232,240,236,0.35);
        margin-bottom: 12px;
    }
    .docs-nav a {
        display: block;
        padding: 6px 12px;
        margin-bottom: 2px;
        border-radius: 6px;
        font-size: 0.88rem;
        color: rgba(232,240,236,0.5);
        text-decoration: none;
        transition: color 0.2s, background 0.2s;
    }
    .docs-nav a:hover {
        color: #e8f0ec;
        background: rgba(255,255,255,0.04);
    }

    /* Content */
    .docs-content h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 56px 0 16px 0;
        padding-top: 24px;
        border-top: 1px solid rgba(255,255,255,0.06);
        color: #e8f0ec;
    }
    .docs-content h2:first-child {
        margin-top: 0;
        border-top: none;
        padding-top: 0;
    }
    .docs-content h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 32px 0 12px 0;
        color: #e8f0ec;
    }
    .docs-content p {
        color: rgba(232,240,236,0.55);
        font-size: 0.92rem;
        line-height: 1.75;
        margin: 0 0 16px 0;
    }
    .docs-content code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85em;
        background: rgba(0,255,179,0.06);
        border: 1px solid rgba(0,255,179,0.1);
        border-radius: 4px;
        padding: 1px 6px;
        color: #4cc496;
    }
    .docs-content ul {
        color: rgba(232,240,236,0.55);
        font-size: 0.92rem;
        line-height: 1.75;
        margin: 0 0 16px 0;
        padding-left: 20px;
    }
    .docs-content li {
        margin-bottom: 6px;
    }
    .docs-content li code {
        color: #4cc496;
    }

    /* Code blocks */
    .docs-codeblock {
        background: #0d1117;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        margin: 16px 0 24px 0;
        overflow: hidden;
    }
    .docs-codeblock-header {
        padding: 8px 16px;
        background: rgba(255,255,255,0.03);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 0.75rem;
        color: rgba(232,240,236,0.35);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    .docs-codeblock pre {
        margin: 0;
        padding: 16px 20px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.82rem;
        line-height: 1.7;
        color: #9ca3af;
        white-space: pre;
        overflow-x: auto;
        tab-size: 2;
    }

    /* Syntax colors */
    .s-tag { color: #7edbb5; }
    .s-comp { color: #e2c77e; font-weight: 700; }
    .s-kw { color: #4cc496; font-weight: 600; }
    .s-str { color: #e2c77e; }
    .s-var { color: #e8ceaf; }
    .s-prop { color: #d4b05a; }
    .s-pipe { color: #4cc496; }
    .s-comm { color: #6e7e72; font-style: italic; }
    .s-num { color: #b2ecd4; }
    .s-punct { color: #6e7e72; }
    .s-sql { color: #7edbb5; }
    .s-html { color: #9ca3af; }
    .s-attr { color: #d4ab84; }

    /* Info callout */
    .docs-callout {
        background: rgba(0,255,179,0.04);
        border: 1px solid rgba(0,255,179,0.12);
        border-radius: 10px;
        padding: 16px 20px;
        margin: 16px 0 24px 0;
        font-size: 0.88rem;
        line-height: 1.65;
        color: rgba(232,240,236,0.6);
    }
    .docs-callout strong {
        color: #4cc496;
    }

    /* Table */
    .docs-table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0 24px 0;
        font-size: 0.85rem;
    }
    .docs-table th {
        text-align: left;
        padding: 10px 14px;
        border-bottom: 2px solid rgba(255,255,255,0.08);
        color: rgba(232,240,236,0.6);
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .docs-table td {
        padding: 10px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        color: rgba(232,240,236,0.5);
    }
    .docs-table td code {
        font-size: 0.82rem;
    }

    @media (max-width: 800px) {
        .docs-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }
        .docs-nav { position: static; }
    }
</style>

<div class="docs-hero">
    <h1>Documentation</h1>
    <p>Learn Motus &mdash; the compiled XML template language that outputs streaming HTML from the edge.</p>
</div>

<div class="docs-grid">
    <nav class="docs-nav">
        <div class="docs-nav-label">Guide</div>
        <a href="#overview">Overview</a>
        <a href="#quick-start">Quick Start</a>
        <a href="#templates">Templates</a>
        <a href="#components">Components</a>
        <a href="#sql">SQL Queries</a>
        <a href="#reactive">Reactive State</a>
        <a href="#pipes">Pipe Transforms</a>
        <a href="#ai-friendly">AI-Friendly</a>
        <a href="#architecture">Architecture</a>
        <a href="#comparison">Comparison Operators</a>
    </nav>

    <div class="docs-content">

        <h2 id="overview">Overview</h2>
        <p>Motus is a compiled XML-based template language. You write .mot files that look like HTML with extra powers: scoped variables, SQL queries, components, reactive state, and pipe transforms. The compiler turns these into binary bytecode, which a WASM VM interprets at the edge to stream HTML to browsers.</p>

        <div class="docs-callout">
            <strong>AI-Friendly:</strong> Motus uses standard HTML + CSS as its output format and XML as its input. LLMs already know both. No virtual DOM, no JSX, no framework-specific abstractions &mdash; just markup that any AI can read, write, and reason about.
        </div>

        <h2 id="quick-start">Quick Start</h2>
        <p>A minimal Motus page is just HTML:</p>
        <div class="docs-codeblock">
            <div class="docs-codeblock-header">hello.mot</div>
            <pre id="code-hello"></pre>
        </div>
        <p>To add dynamic data, use <code>let</code> bindings and <code>output</code>:</p>
        <div class="docs-codeblock">
            <div class="docs-codeblock-header">greeting.mot</div>
            <pre id="code-greeting"></pre>
        </div>

        <h2 id="templates">Templates</h2>
        <h3>Let Bindings</h3>
        <p>The <code>let</code> tag creates scoped variables. The variable is visible only inside the body of the <code>let</code> tag. Use <code>output</code> to interpolate values.</p>
        <div class="docs-codeblock">
            <pre id="code-let"></pre>
        </div>

        <h3>Conditionals</h3>
        <p>Use <code>if</code>, <code>elsif</code>, and <code>else</code> for conditional rendering:</p>
        <div class="docs-codeblock">
            <pre id="code-if"></pre>
        </div>

        <h3>Loops</h3>
        <p>Iterate over collections with <code>for</code>. An optional index variable is available:</p>
        <div class="docs-codeblock">
            <pre id="code-for"></pre>
        </div>

        <h3>Match</h3>
        <p>Pattern matching for multi-branch conditionals:</p>
        <div class="docs-codeblock">
            <pre id="code-match"></pre>
        </div>

        <h2 id="components">Components</h2>
        <p>Define reusable components with <code>defcomp</code>. Props are declared between pipes. Use <code>children</code> for the default slot.</p>
        <div class="docs-codeblock">
            <div class="docs-codeblock-header">Card.mot</div>
            <pre id="code-defcomp"></pre>
        </div>
        <p>Import and use components:</p>
        <div class="docs-codeblock">
            <pre id="code-import"></pre>
        </div>

        <h3>Component Features</h3>
        <table class="docs-table">
            <tr><th>Feature</th><th>Syntax</th><th>Description</th></tr>
            <tr><td>Props</td><td><code>| name, price: string = "0" |</code></td><td>Typed props with defaults</td></tr>
            <tr><td>Slots</td><td><code>&lt;children&gt;</code></td><td>Default slot for nested content</td></tr>
            <tr><td>Scoped CSS</td><td><code>&lt;style&gt;</code> inside defcomp</td><td>CSS scoped to component</td></tr>
            <tr><td>Dynamic import</td><td><code>&lt;import X from "..." dynamic&gt;</code></td><td>Load at edge render time</td></tr>
        </table>

        <h2 id="sql">SQL Queries</h2>
        <p id="docs-sql-desc"></p>
        <div class="docs-codeblock">
            <pre id="code-sql"></pre>
        </div>

        <div class="docs-callout">
            <strong>Security:</strong> SQL queries are compiled to queryRef signatures. At runtime, the edge worker sends the queryRef to the origin, which validates and executes the query. Raw SQL never reaches the browser.
        </div>

        <h2 id="reactive">Reactive State</h2>
        <p>Use <code>var</code> to declare reactive state and <code>set</code> to update it. Reactive binding markers enable browser-side targeted DOM updates.</p>
        <div class="docs-codeblock">
            <pre id="code-reactive"></pre>
        </div>

        <h3>Reactive Binding Markers</h3>
        <p>The compiler emits special markers (<code>@bind</code>, <code>@set</code>, <code>@exprbind</code>) that the browser runtime uses to update only the affected DOM nodes when state changes.</p>

        <h2 id="pipes">Pipe Transforms</h2>
        <p>Chain built-in transforms with the pipe operator:</p>
        <div class="docs-codeblock">
            <pre id="code-pipes"></pre>
        </div>

        <h3>Built-in Functions</h3>
        <table class="docs-table">
            <tr><th>Function</th><th>Description</th></tr>
            <tr><td><code>uppercase</code></td><td>Convert string to uppercase</td></tr>
            <tr><td><code>lowercase</code></td><td>Convert string to lowercase</td></tr>
            <tr><td><code>trim</code></td><td>Strip leading/trailing whitespace</td></tr>
            <tr><td><code>length</code></td><td>Return collection or string length</td></tr>
            <tr><td><code>reverse</code></td><td>Reverse a string or array</td></tr>
            <tr><td><code>json</code></td><td>Serialize value to JSON string</td></tr>
        </table>

        <h2 id="ai-friendly">AI-Friendly Design</h2>
        <p>Motus is designed to be the ideal language for AI-assisted development:</p>
        <ul>
            <li><strong>XML syntax</strong> &mdash; LLMs are trained on billions of HTML/XML tokens. Motus templates are immediately familiar.</li>
            <li><strong>HTML + CSS output</strong> &mdash; The output format is standard HTML and CSS. No framework-specific runtime, no virtual DOM diffing, no hydration mismatch.</li>
            <li><strong>Position-based</strong> &mdash; No namespace prefixes or complex attribute binding syntax. <code>&lt;let name "Alice"&gt;</code> is self-evident.</li>
            <li id="docs-ai-sql"></li>
            <li><strong>Scoped components</strong> &mdash; Each component is a self-contained file with markup, style, and behavior. Perfect context window for an LLM.</li>
        </ul>

        <div class="docs-callout">
            <strong>Why this matters:</strong> When an AI generates or modifies a Motus template, the output is standard web markup. There is no transpilation gap, no framework-specific gotchas, and no hidden runtime behavior. What the AI writes is what the browser renders.
        </div>

        <h2 id="architecture">Architecture</h2>
        <p>The Motus compilation pipeline:</p>
        <ul>
            <li><strong>Origin Server</strong> (C99) &mdash; Compiles .mot source to bytecode. Caches modules. Handles SQL data RPCs.</li>
            <li><strong>Edge Worker</strong> (Cloudflare) &mdash; Interprets bytecode via WASM VM. Streams HTML response chunks.</li>
            <li><strong>Browser</strong> &mdash; Receives streamed HTML. Reactive markers enable targeted DOM updates.</li>
        </ul>
        <p>Bytecode format: little-endian binary, magic <code>0x00544F4D</code> ("MOT\0"), version 1.2. Contains: constants pool, interned strings, data request signatures, dependency paths, component references, and instruction chunks.</p>

        <h2 id="comparison">Comparison Operators</h2>
        <p>Because Motus uses XML syntax, angle brackets are reserved. Use keyword operators instead:</p>
        <table class="docs-table">
            <tr><th>Keyword</th><th>Meaning</th><th>Equivalent</th></tr>
            <tr><td><code>eq</code></td><td>Equal</td><td><code>==</code></td></tr>
            <tr><td><code>neq</code></td><td>Not equal</td><td><code>!=</code></td></tr>
            <tr><td><code>lt</code></td><td>Less than</td><td><code>&lt;</code></td></tr>
            <tr><td><code>gt</code></td><td>Greater than</td><td><code>&gt;</code></td></tr>
            <tr><td><code>lte</code></td><td>Less than or equal</td><td><code>&lt;=</code></td></tr>
            <tr><td><code>gte</code></td><td>Greater than or equal</td><td><code>&gt;=</code></td></tr>
        </table>

    </div>
</div>

<script>
(function() {
    function s(cls, text) {
        return '<span class="s-' + cls + '">' + text + '</span>';
    }

    /* Inject text containing reserved keywords */
    document.getElementById('docs-sql-desc').innerHTML = 'SQL is a first-class citizen. Embed queries directly in <code>let</code> bindings. The compiler extracts SQL into queryRef + signature pairs &mdash; no raw SQL text ships in bytecode.';
    document.getElementById('docs-ai-sql').innerHTML = '<strong>Declarative SQL</strong> &mdash; Data requirements are declared in-template. An AI can see exactly what data a page needs without tracing through service layers.';

    document.getElementById('code-hello').innerHTML = [
        s('html','&lt;!DOCTYPE html&gt;'),
        s('html','&lt;h1&gt;') + 'Hello, World!' + s('html','&lt;/h1&gt;'),
        s('html','&lt;p&gt;') + 'This is a Motus page.' + s('html','&lt;/p&gt;')
    ].join('\n');

    document.getElementById('code-greeting').innerHTML = [
        s('tag','&lt;let') + ' ' + s('var','name') + ' ' + s('str','"World"') + s('tag','&gt;'),
        '  ' + s('html','&lt;h1&gt;') + 'Hello, ' + s('tag','&lt;output') + ' ' + s('var','name') + s('tag','&gt;') + '!' + s('html','&lt;/h1&gt;'),
        s('tag','&lt;/let&gt;')
    ].join('\n');

    document.getElementById('code-let').innerHTML = [
        s('tag','&lt;let') + ' ' + s('var','greeting') + ' ' + s('str','"Hello"') + s('tag','&gt;'),
        '  ' + s('tag','&lt;let') + ' ' + s('var','name') + ' ' + s('str','"Alice"') + s('tag','&gt;'),
        '    ' + s('html','&lt;p&gt;') + s('tag','&lt;output') + ' ' + s('var','greeting') + s('tag','&gt;') + ', ' + s('tag','&lt;output') + ' ' + s('var','name') + s('tag','&gt;') + '!' + s('html','&lt;/p&gt;'),
        '  ' + s('tag','&lt;/let&gt;'),
        s('tag','&lt;/let&gt;'),
        s('comm','&lt;!-- name is no longer in scope here --&gt;')
    ].join('\n');

    document.getElementById('code-if').innerHTML = [
        s('tag','&lt;if') + ' ' + s('var','user.role') + ' ' + s('kw','eq') + ' ' + s('str','"admin"') + s('tag','&gt;'),
        '  ' + s('html','&lt;p&gt;') + 'Welcome, administrator.' + s('html','&lt;/p&gt;'),
        s('tag','&lt;elsif') + ' ' + s('var','user.role') + ' ' + s('kw','eq') + ' ' + s('str','"editor"') + s('tag','&gt;'),
        '  ' + s('html','&lt;p&gt;') + 'Welcome, editor.' + s('html','&lt;/p&gt;'),
        s('tag','&lt;else&gt;'),
        '  ' + s('html','&lt;p&gt;') + 'Welcome, guest.' + s('html','&lt;/p&gt;'),
        s('tag','&lt;/if&gt;')
    ].join('\n');

    document.getElementById('code-for').innerHTML = [
        s('tag','&lt;for') + ' ' + s('var','item') + ' ' + s('kw','in') + ' ' + s('var','items') + s('tag','&gt;'),
        '  ' + s('html','&lt;div&gt;') + s('tag','&lt;output') + ' ' + s('var','item.name') + s('tag','&gt;') + s('html','&lt;/div&gt;'),
        s('tag','&lt;/for&gt;'),
        '',
        s('comm','&lt;!-- With index --&gt;'),
        s('tag','&lt;for') + ' ' + s('var','item') + ' ' + s('kw','in') + ' ' + s('var','items') + ' ' + s('kw','with index') + ' ' + s('var','i') + s('tag','&gt;'),
        '  ' + s('html','&lt;div&gt;') + '#' + s('tag','&lt;output') + ' ' + s('var','i') + s('tag','&gt;') + ': ' + s('tag','&lt;output') + ' ' + s('var','item.name') + s('tag','&gt;') + s('html','&lt;/div&gt;'),
        s('tag','&lt;/for&gt;')
    ].join('\n');

    document.getElementById('code-match').innerHTML = [
        s('tag','&lt;match') + ' ' + s('var','status') + s('tag','&gt;'),
        '  ' + s('tag','&lt;case') + ' ' + s('str','"active"') + s('tag','&gt;'),
        '    ' + s('html','&lt;span') + ' ' + s('attr','class') + s('punct','=') + s('str','"badge-green"') + s('html','&gt;') + 'Active' + s('html','&lt;/span&gt;'),
        '  ' + s('tag','&lt;/case&gt;'),
        '  ' + s('tag','&lt;case') + ' ' + s('str','"pending"') + s('tag','&gt;'),
        '    ' + s('html','&lt;span') + ' ' + s('attr','class') + s('punct','=') + s('str','"badge-yellow"') + s('html','&gt;') + 'Pending' + s('html','&lt;/span&gt;'),
        '  ' + s('tag','&lt;/case&gt;'),
        '  ' + s('tag','&lt;default&gt;'),
        '    ' + s('html','&lt;span&gt;') + 'Unknown' + s('html','&lt;/span&gt;'),
        '  ' + s('tag','&lt;/default&gt;'),
        s('tag','&lt;/match&gt;')
    ].join('\n');

    document.getElementById('code-defcomp').innerHTML = [
        s('tag','&lt;defcomp') + ' ' + s('comp','Card') + ' ' + s('punct','|') + ' ' + s('prop','title') + s('punct',',') + ' ' + s('prop','subtitle') + ' ' + s('punct','|&gt;'),
        '  ' + s('html','&lt;style&gt;'),
        '    .card {',
        '      background: white;',
        '      border-radius: 12px;',
        '      padding: 24px;',
        '    }',
        '  ' + s('html','&lt;/style&gt;'),
        '  ' + s('html','&lt;div') + ' ' + s('attr','class') + s('punct','=') + s('str','"card"') + s('html','&gt;'),
        '    ' + s('html','&lt;h2&gt;') + s('tag','&lt;output') + ' ' + s('var','title') + s('tag','&gt;') + s('html','&lt;/h2&gt;'),
        '    ' + s('html','&lt;p&gt;') + s('tag','&lt;output') + ' ' + s('var','subtitle') + s('tag','&gt;') + s('html','&lt;/p&gt;'),
        '    ' + s('tag','&lt;children&gt;'),
        '  ' + s('html','&lt;/div&gt;'),
        s('tag','&lt;/defcomp&gt;')
    ].join('\n');

    document.getElementById('code-import').innerHTML = [
        s('tag','&lt;import') + ' ' + s('comp','Card') + ' ' + s('kw','from') + ' ' + s('str','"components/Card"') + s('tag','&gt;'),
        '',
        s('tag','&lt;') + s('comp','Card') + ' ' + s('attr','title') + s('punct','=') + s('str','"Hello"') + ' ' + s('attr','subtitle') + s('punct','=') + s('str','"World"') + s('tag','&gt;'),
        '  ' + s('html','&lt;p&gt;') + 'This goes into the default slot.' + s('html','&lt;/p&gt;'),
        s('tag','&lt;/') + s('comp','Card') + s('tag','&gt;')
    ].join('\n');

    document.getElementById('code-sql').innerHTML = [
        s('comm','&lt;!-- Static query (resolved at compile time) --&gt;'),
        s('tag','&lt;let') + ' ' + s('var','products'),
        '    ' + s('kw','select') + ' ' + s('sql','name, price'),
        '    ' + s('kw','from') + ' ' + s('sql','products'),
        '    ' + s('kw','where') + ' ' + s('sql','in_stock') + ' ' + s('kw','eq') + ' ' + s('num','1'),
        '    ' + s('kw','order by') + ' ' + s('sql','price') + ' ' + s('kw','desc'),
        '    ' + s('kw','limit') + ' ' + s('num','10') + s('tag','&gt;'),
        '  ' + s('tag','&lt;for') + ' ' + s('var','p') + ' ' + s('kw','in') + ' ' + s('var','products') + s('tag','&gt;'),
        '    ' + s('html','&lt;p&gt;') + s('tag','&lt;output') + ' ' + s('var','p.name') + s('tag','&gt;') + ': $' + s('tag','&lt;output') + ' ' + s('var','p.price') + s('tag','&gt;') + s('html','&lt;/p&gt;'),
        '  ' + s('tag','&lt;/for&gt;'),
        s('tag','&lt;/let&gt;'),
        '',
        s('comm','&lt;!-- Dynamic query (fetched at edge render time) --&gt;'),
        s('tag','&lt;let') + ' ' + s('var','posts') + ' ' + s('kw','dynamic'),
        '    ' + s('kw','select') + ' ' + s('sql','title, author'),
        '    ' + s('kw','from') + ' ' + s('sql','posts'),
        '    ' + s('kw','order by') + ' ' + s('sql','id') + ' ' + s('kw','desc'),
        '    ' + s('kw','limit') + ' ' + s('num','5') + s('tag','&gt;'),
        '  ' + s('comm','&lt;!-- ... --&gt;'),
        s('tag','&lt;/let&gt;')
    ].join('\n');

    document.getElementById('code-reactive').innerHTML = [
        s('tag','&lt;var') + ' ' + s('var','counter') + ' ' + s('num','0') + ' ' + s('tag','/&gt;'),
        s('tag','&lt;var') + ' ' + s('var','profile') + ' ' + s('punct','{') + s('attr','name') + s('punct',':') + ' ' + s('str','"Guest"') + s('punct','}') + ' ' + s('tag','/&gt;'),
        '',
        s('html','&lt;p&gt;') + 'Count: ' + s('html','&lt;strong&gt;'),
        '  ' + s('tag','&lt;output') + ' ' + s('var','counter') + s('tag','&gt;'),
        s('html','&lt;/strong&gt;&lt;/p&gt;'),
        '',
        s('html','&lt;p&gt;') + 'Next: ' + s('html','&lt;strong&gt;'),
        '  ' + s('tag','&lt;output') + ' ' + s('var','counter') + ' ' + s('punct','+') + ' ' + s('num','1') + s('tag','&gt;'),
        s('html','&lt;/strong&gt;&lt;/p&gt;'),
        '',
        s('tag','&lt;set') + ' ' + s('var','counter') + ' ' + s('var','counter') + ' ' + s('punct','+') + ' ' + s('num','1') + ' ' + s('tag','/&gt;')
    ].join('\n');

    document.getElementById('code-pipes').innerHTML = [
        s('comm','&lt;!-- Single transform --&gt;'),
        s('tag','&lt;output') + ' ' + s('var','name') + ' ' + s('pipe','|') + ' ' + s('kw','uppercase') + s('tag','&gt;'),
        '',
        s('comm','&lt;!-- Chained transforms --&gt;'),
        s('tag','&lt;output') + ' ' + s('var','input') + ' ' + s('pipe','|') + ' ' + s('kw','trim') + ' ' + s('pipe','|') + ' ' + s('kw','uppercase') + s('tag','&gt;'),
        '',
        s('comm','&lt;!-- In component props --&gt;'),
        s('tag','&lt;') + s('comp','Badge') + ' ' + s('attr','label') + s('punct','=') + s('var','status') + ' ' + s('pipe','|') + ' ' + s('kw','lowercase') + ' ' + s('tag','/&gt;')
    ].join('\n');
})();
</script>
</Layout>
