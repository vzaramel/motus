<import Layout from "components/Layout">

<Layout title="Playground" subtitle="">
    <style>
        .layout-container {
            max-width: min(99vw, 2200px);
            padding: 80px 10px 10px 10px;
        }

        .playground-shell {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: clamp(620px, calc(100vh - 100px), 1200px);
        }

        .playground-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 32px;
        }

        .playground-run {
            width: 32px;
            height: 32px;
            border: 1px solid rgba(0,255,179,0.3);
            background: rgba(0,255,179,0.06);
            color: #00ffb3;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.95rem;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            transition: background 0.2s, border-color 0.2s;
        }
        .playground-run:hover {
            background: rgba(0,255,179,0.12);
            border-color: rgba(0,255,179,0.5);
        }
        .playground-run:disabled {
            opacity: 0.4;
            cursor: default;
        }

        .playground-status {
            font-size: 0.88em;
            color: rgba(232,240,236,0.5);
            min-height: 1em;
        }

        .playground-grid {
            display: grid;
            grid-template-columns: minmax(420px, 1fr) minmax(420px, 1fr);
            gap: 8px;
            flex: 1;
            min-height: 0;
        }

        .playground-form {
            margin: 0;
            min-height: 0;
            height: 100%;
        }

        .playground-editor {
            width: 100%;
            height: 100%;
            min-height: 0;
            border: 1px solid rgba(0,255,179,0.12);
            border-radius: 8px;
            overflow: hidden;
            background: #0f1e2c;
        }

        .playground-source {
            width: 100%;
            height: 100%;
            min-height: 0;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 13px;
            line-height: 1.4;
            border: 1px solid rgba(0,255,179,0.12);
            border-radius: 8px;
            padding: 8px;
            resize: none;
            display: none;
            background: #0f1e2c;
            color: #e8f0ec;
        }

        .playground-output {
            border: 1px solid rgba(0,255,179,0.12);
            border-radius: 8px;
            background: #0f1e2c;
            color: #e8f0ec;
            padding: 8px;
            min-height: 0;
            overflow: auto;
        }

        @media (max-width: 980px) {
            .playground-shell {
                min-height: auto;
            }
            .playground-grid {
                grid-template-columns: 1fr;
                min-height: auto;
            }
            .playground-editor,
            .playground-source,
            .playground-output {
                min-height: 46vh;
                height: 46vh;
            }
        }
    </style>

    <section class="playground-shell">
        <div class="playground-toolbar">
            <button type="button" id="playground-run" class="playground-run" title="Compile and Render" aria-label="Compile and Render">&#9654;</button>
            <div id="playground-status" class="playground-status"></div>
        </div>

        <section class="playground-grid">
            <form id="playground-form" class="playground-form">
                <div id="playground-editor" class="playground-editor"></div>
                <textarea id="playground-source" class="playground-source" spellcheck="false"></textarea>
            </form>
            <div id="playground-output" class="playground-output"></div>
        </section>
    </section>

    <script>
        (function () {
            var form = document.getElementById('playground-form');
            var editorEl = document.getElementById('playground-editor');
            var sourceEl = document.getElementById('playground-source');
            var statusEl = document.getElementById('playground-status');
            var outputEl = document.getElementById('playground-output');
            var runButton = document.getElementById('playground-run');
            var editor = null;
            var motWasm = null;
            var ACE_CDN_URL = 'https://cdn.jsdelivr.net/npm/ace-builds@1.36.2/src-min-noconflict/ace.js';

            if (!form || !editorEl || !sourceEl || !statusEl || !outputEl || !runButton) return;

            var defaultSource = [
                '<defcomp DemoCard | title, body |>',
                '    <style>',
                '        .demo-card {',
                '            border: 1px solid rgba(0,255,179,0.15);',
                '            border-radius: 10px;',
                '            padding: 14px;',
                '            background: #152436;',
                '        }',
                '        .demo-card h3 {',
                '            margin: 0 0 8px 0;',
                '            color: #e8f0ec;',
                '        }',
                '        .demo-card p {',
                '            margin: 0;',
                '            color: rgba(232,240,236,0.6);',
                '            line-height: 1.5;',
                '        }',
                '    </style>',
                '    <article class="demo-card">',
                '        <h3><output title></h3>',
                '        <p><output body></p>',
                '    </article>',
                '</defcomp>',
                '',
                '<DemoCard',
                '    title="Hello from Motus"',
                '    body="Compiled and rendered entirely by WASM." />'
            ].join('\n');

            sourceEl.value = defaultSource;

            /* ===== WASM compiler + VM ===== */
            function findWasmUrl() {
                var path = window.location.pathname;
                if (path.indexOf('/motus/') === 0) return '/motus/mot-runtime.wasm';
                return '/mot-runtime.wasm';
            }

            async function loadMotusWasm() {
                var htmlBuf = '';

                var imports = {
                    env: {
                        host_output: function(ptr, len) {
                            var bytes = new Uint8Array(motWasm.memory.buffer, ptr, len);
                            htmlBuf += new TextDecoder().decode(bytes);
                        },
                        host_output_text: function(ptr, len) {
                            var bytes = new Uint8Array(motWasm.memory.buffer, ptr, len);
                            var text = new TextDecoder().decode(bytes);
                            htmlBuf += text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                        },
                        host_error: function(ptr, len) {
                            var bytes = new Uint8Array(motWasm.memory.buffer, ptr, len);
                            console.error('[mot]', new TextDecoder().decode(bytes));
                        },
                        host_log: function(ptr, len) {
                            var bytes = new Uint8Array(motWasm.memory.buffer, ptr, len);
                            console.log('[mot]', new TextDecoder().decode(bytes));
                        },
                        host_render_complete: function() {},
                        host_dep_start: function() {},
                        host_dep_end: function() {},
                        host_component_start: function() {},
                        host_component_end: function() {},
                        host_slot_default_start: function() {},
                        host_slot_default_end: function() {},
                        host_debug_step: function() {},
                        host_fetch_data: function() {
                            console.warn('[mot] Data queries not supported');
                        },
                        host_load_component: function() {
                            console.warn('[mot] Dynamic components not supported');
                        },
                        host_load_component_linked: function() {
                            console.warn('[mot] Linked components not supported');
                        }
                    }
                };

                var wasmUrl = findWasmUrl();
                var result = await WebAssembly.instantiateStreaming(fetch(wasmUrl), imports);
                var ex = result.instance.exports;

                motWasm = {
                    memory: ex.memory,
                    exports: ex,
                    compile: function(source) {
                        ex.mot_reset_alloc();
                        var enc = new TextEncoder().encode(source);
                        var ptr = ex.mot_alloc(enc.length + 1);
                        if (!ptr) return { error: 'Failed to allocate memory' };
                        new Uint8Array(ex.memory.buffer, ptr, enc.length).set(enc);
                        new Uint8Array(ex.memory.buffer)[ptr + enc.length] = 0;

                        var rc = ex.mot_wasm_compile(ptr, enc.length);
                        if (rc !== 0) {
                            var ePtr = ex.mot_wasm_get_error_ptr();
                            var eLen = ex.mot_wasm_get_error_len();
                            var errMsg = eLen > 0
                                ? new TextDecoder().decode(new Uint8Array(ex.memory.buffer, ePtr, eLen))
                                : 'Unknown compilation error';
                            return { error: errMsg };
                        }

                        var bcPtr = ex.mot_wasm_get_bytecode_ptr();
                        var bcLen = ex.mot_wasm_get_bytecode_len();
                        var bytecode = new Uint8Array(ex.memory.buffer, bcPtr, bcLen).slice();

                        var cssPtr = ex.mot_wasm_get_css_ptr();
                        var cssLen = ex.mot_wasm_get_css_len();
                        var css = cssLen > 0
                            ? new TextDecoder().decode(new Uint8Array(ex.memory.buffer, cssPtr, cssLen))
                            : '';

                        return { bytecode: bytecode, css: css };
                    },
                    render: function(bytecode) {
                        htmlBuf = '';
                        ex.mot_reset_alloc();

                        var ptr = ex.mot_alloc(bytecode.length);
                        if (!ptr) return { error: 'Failed to allocate memory for bytecode' };
                        new Uint8Array(ex.memory.buffer, ptr, bytecode.length).set(bytecode);

                        var rc = ex.mot_init(ptr, bytecode.length);
                        if (rc !== 0) return { error: 'Failed to initialize VM' };

                        rc = ex.mot_render();
                        if (rc !== 0 && rc !== -2) return { error: 'Render failed (code ' + rc + ')' };

                        return { html: htmlBuf };
                    }
                };

                return motWasm;
            }

            /* ===== Ace editor ===== */
            function setupAceEditor() {
                editor = window.ace.edit('playground-editor');
                editor.session.setMode('ace/mode/html');
                editor.setTheme('ace/theme/tomorrow_night');
                editor.setOptions({ fontSize: '13px', showPrintMargin: false, useWorker: false });
                editor.setValue(defaultSource, -1);
                editor.commands.addCommand({
                    name: 'run-playground',
                    bindKey: { win: 'Ctrl-Enter', mac: 'Command-Enter' },
                    exec: function () { runPlayground(); }
                });
                editorEl.style.display = 'block';
                sourceEl.style.display = 'none';
            }

            function useTextareaFallback() {
                editorEl.style.display = 'none';
                sourceEl.style.display = 'block';
            }

            function readSource() {
                if (editor) return editor.getValue();
                return sourceEl.value || '';
            }

            function loadAceEditorIfNeeded() {
                if (window.ace && typeof window.ace.edit === 'function') {
                    setupAceEditor();
                    return Promise.resolve();
                }
                return new Promise(function (resolve) {
                    var script = document.createElement('script');
                    script.src = ACE_CDN_URL;
                    script.async = true;
                    script.onload = resolve;
                    script.onerror = resolve;
                    document.head.appendChild(script);
                }).then(function () {
                    if (window.ace && typeof window.ace.edit === 'function') {
                        setupAceEditor();
                    } else {
                        useTextareaFallback();
                    }
                });
            }

            /* ===== Compile + render ===== */
            function runPlayground() {
                var source = readSource();
                if (!source.trim()) {
                    statusEl.textContent = 'Source is empty.';
                    outputEl.innerHTML = '';
                    return;
                }
                if (!motWasm) {
                    statusEl.textContent = 'WASM not loaded yet...';
                    return;
                }

                runButton.disabled = true;
                statusEl.textContent = 'Compiling...';

                try {
                    var compiled = motWasm.compile(source);
                    if (compiled.error) {
                        statusEl.textContent = 'Error: ' + compiled.error;
                        outputEl.innerHTML = '';
                        runButton.disabled = false;
                        return;
                    }

                    var rendered = motWasm.render(compiled.bytecode);
                    if (rendered.error) {
                        statusEl.textContent = 'Render error: ' + rendered.error;
                        outputEl.innerHTML = '';
                        runButton.disabled = false;
                        return;
                    }

                    var html = '';
                    if (compiled.css) html += '<style>' + compiled.css + '</style>';
                    html += rendered.html;
                    outputEl.innerHTML = html;
                    statusEl.textContent = 'Done (' + compiled.bytecode.length + ' bytes bytecode)';
                } catch (err) {
                    statusEl.textContent = 'Error: ' + (err.message || String(err));
                    outputEl.innerHTML = '';
                } finally {
                    runButton.disabled = false;
                }
            }

            form.addEventListener('submit', function (e) { e.preventDefault(); runPlayground(); });
            runButton.addEventListener('click', function () { runPlayground(); });
            sourceEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); runPlayground(); }
            });

            /* Boot: load WASM + Ace, then auto-run */
            statusEl.textContent = 'Loading compiler...';
            Promise.all([loadMotusWasm(), loadAceEditorIfNeeded()]).then(function () {
                statusEl.textContent = 'Ready';
                runPlayground();
            }).catch(function (err) {
                statusEl.textContent = 'Failed to load WASM: ' + (err.message || String(err));
            });
        })();
    </script>
</Layout>
