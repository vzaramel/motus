<defcomp Header | title, subtitle |>
<style>
    .header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 1000;
        background: rgba(6,12,16,0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(0,255,179,0.08);
        height: 64px;
    }
    .header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .header-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 1.2rem;
        color: #e8f0ec;
        text-decoration: none;
    }
    .header-brand svg {
        width: 28px;
        height: 28px;
        color: #4cc496;
    }
    .header nav {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .header nav a {
        color: rgba(232,240,236,0.55);
        text-decoration: none;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s, background 0.2s;
    }
    .header nav a:hover {
        color: #e8f0ec;
        background: rgba(255,255,255,0.06);
    }
    .header-cta {
        border: 1px solid rgba(0,255,179,0.3) !important;
        color: #00ffb3 !important;
        background: rgba(0,255,179,0.04);
    }
    .header-cta:hover {
        background: rgba(0,255,179,0.1) !important;
        border-color: rgba(0,255,179,0.5) !important;
    }
</style>
<header class="header">
    <div class="header-content">
        <a href="/" class="header-brand">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="16" y1="2" x2="16" y2="30"/>
                <path d="M16 6 C12 6 8 10 8 14 C8 18 12 18 16 14"/>
                <path d="M16 6 C20 6 24 10 24 14 C24 18 20 18 16 14"/>
                <path d="M16 14 C11 14 6 18 6 22 C6 26 11 26 16 22"/>
                <path d="M16 14 C21 14 26 18 26 22 C26 26 21 26 16 22"/>
                <path d="M12 30 C12 26 14 24 16 24 C18 24 20 26 20 30"/>
            </svg>
            Motus
        </a>
        <nav>
            <a href="/">Home</a>
            <a href="/docs">Docs</a>
            <a href="/playground" class="header-cta">Playground</a>
        </nav>
    </div>
</header>
</defcomp>
